<?xml version="1.0" encoding="utf-8"?>
<!--
  PLCcom OPC UA SDK - Workshop 41: Sample NodeSet

  This file defines a small address space in the OPC UA NodeSet2 XML format.
  It is used by Server Workshop 41 to demonstrate how to import type definitions
  and pre-built instances into an OPC UA server.

  Namespace layout on the server:
    ns=0  OPC UA Standard
    ns=1  SDK internal
    ns=2  Server Application Namespace (http://indi-an.com/opcua/workshop/nodeset-import)
    ns=3  Workshop NodeSet Namespace   (urn:plccom:workshop:nodeset)

  Structure:
  Types     : SensorType (ns=2), MotorType (ns=3)
  Instances : Sensors/TempSensor1, PressureSensor1 (ns=2)
              Motors/Motor1, Motor2                (ns=3)

  NodeId ranges used:
    1000-1999  Type definitions
    2000-2999  Instances
-->
<UANodeSet xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:xsd="http://www.w3.org/2001/XMLSchema"
           xmlns="http://opcfoundation.org/UA/2011/03/UANodeSet.xsd"
           xmlns:uax="http://opcfoundation.org/UA/2008/02/Types.xsd">

  <NamespaceUris>
    <Uri>http://indi-an.com/opcua/workshop/nodeset-import</Uri>
    <Uri>urn:plccom:workshop:nodeset</Uri>
  </NamespaceUris>

  <Aliases>
    <Alias Alias="Boolean">i=1</Alias>
    <Alias Alias="Double">i=11</Alias>
    <Alias Alias="String">i=12</Alias>
    <Alias Alias="HasComponent">i=47</Alias>
    <Alias Alias="HasProperty">i=46</Alias>
    <Alias Alias="HasSubtype">i=45</Alias>
    <Alias Alias="HasTypeDefinition">i=40</Alias>
    <Alias Alias="Organizes">i=35</Alias>
    <Alias Alias="BaseObjectType">i=58</Alias>
    <Alias Alias="BaseDataVariableType">i=63</Alias>
    <Alias Alias="PropertyType">i=68</Alias>
    <Alias Alias="FolderType">i=61</Alias>
  </Aliases>

  <!-- ================================================================== -->
  <!-- TYPE DEFINITIONS                                                    -->
  <!-- ================================================================== -->

  <!-- SensorType (ns=2 - server application namespace) -->
  <UAObjectType NodeId="ns=2;i=1100" BrowseName="2:SensorType">
    <DisplayName>SensorType</DisplayName>
    <Description>A generic sensor with measured value, unit and alarm state.</Description>
    <References>
      <Reference ReferenceType="HasSubtype" IsForward="false">BaseObjectType</Reference>
      <Reference ReferenceType="HasComponent" IsForward="true">ns=2;i=1101</Reference>
      <Reference ReferenceType="HasProperty"  IsForward="true">ns=2;i=1102</Reference>
      <Reference ReferenceType="HasComponent" IsForward="true">ns=2;i=1103</Reference>
    </References>
  </UAObjectType>

  <UAVariable NodeId="ns=2;i=1101" BrowseName="2:Value" DataType="Double" ParentNodeId="ns=2;i=1100" AccessLevel="3">
    <DisplayName>Value</DisplayName>
    <Description>Current measured value.</Description>
    <References>
      <Reference ReferenceType="HasTypeDefinition" IsForward="true">BaseDataVariableType</Reference>
      <Reference ReferenceType="HasComponent" IsForward="false">ns=2;i=1100</Reference>
    </References>
    <Value><uax:Double>0</uax:Double></Value>
  </UAVariable>

  <UAVariable NodeId="ns=2;i=1102" BrowseName="2:Unit" DataType="String" ParentNodeId="ns=2;i=1100">
    <DisplayName>Unit</DisplayName>
    <Description>Engineering unit, e.g. degC, bar, m/s.</Description>
    <References>
      <Reference ReferenceType="HasTypeDefinition" IsForward="true">PropertyType</Reference>
      <Reference ReferenceType="HasProperty" IsForward="false">ns=2;i=1100</Reference>
    </References>
  </UAVariable>

  <UAVariable NodeId="ns=2;i=1103" BrowseName="2:InAlarm" DataType="Boolean" ParentNodeId="ns=2;i=1100" AccessLevel="3">
    <DisplayName>InAlarm</DisplayName>
    <Description>True when the measured value is outside the configured limits.</Description>
    <References>
      <Reference ReferenceType="HasTypeDefinition" IsForward="true">BaseDataVariableType</Reference>
      <Reference ReferenceType="HasComponent" IsForward="false">ns=2;i=1100</Reference>
    </References>
    <Value><uax:Boolean>false</uax:Boolean></Value>
  </UAVariable>

  <!-- MotorType (ns=3 - workshop nodeset namespace) -->
  <UAObjectType NodeId="ns=3;i=1000" BrowseName="3:MotorType">
    <DisplayName>MotorType</DisplayName>
    <Description>A motor with speed, running state and serial number.</Description>
    <References>
      <Reference ReferenceType="HasSubtype" IsForward="false">BaseObjectType</Reference>
      <Reference ReferenceType="HasComponent" IsForward="true">ns=3;i=1001</Reference>
      <Reference ReferenceType="HasComponent" IsForward="true">ns=3;i=1002</Reference>
      <Reference ReferenceType="HasProperty"  IsForward="true">ns=3;i=1003</Reference>
    </References>
  </UAObjectType>

  <UAVariable NodeId="ns=3;i=1001" BrowseName="3:Speed" DataType="Double" ParentNodeId="ns=3;i=1000" AccessLevel="3">
    <DisplayName>Speed</DisplayName>
    <Description>Motor speed in RPM.</Description>
    <References>
      <Reference ReferenceType="HasTypeDefinition" IsForward="true">BaseDataVariableType</Reference>
      <Reference ReferenceType="HasComponent" IsForward="false">ns=3;i=1000</Reference>
    </References>
    <Value><uax:Double>0</uax:Double></Value>
  </UAVariable>

  <UAVariable NodeId="ns=3;i=1002" BrowseName="3:Running" DataType="Boolean" ParentNodeId="ns=3;i=1000" AccessLevel="3">
    <DisplayName>Running</DisplayName>
    <Description>True when the motor is running.</Description>
    <References>
      <Reference ReferenceType="HasTypeDefinition" IsForward="true">BaseDataVariableType</Reference>
      <Reference ReferenceType="HasComponent" IsForward="false">ns=3;i=1000</Reference>
    </References>
    <Value><uax:Boolean>false</uax:Boolean></Value>
  </UAVariable>

  <UAVariable NodeId="ns=3;i=1003" BrowseName="3:SerialNumber" DataType="String" ParentNodeId="ns=3;i=1000">
    <DisplayName>SerialNumber</DisplayName>
    <Description>Factory serial number of this motor.</Description>
    <References>
      <Reference ReferenceType="HasTypeDefinition" IsForward="true">PropertyType</Reference>
      <Reference ReferenceType="HasProperty" IsForward="false">ns=3;i=1000</Reference>
    </References>
  </UAVariable>

  <!-- ================================================================== -->
  <!-- INSTANCES                                                           -->
  <!-- ================================================================== -->

  <!-- Sensors folder (ns=2) -->
  <UAObject NodeId="ns=2;i=2100" BrowseName="2:Sensors">
    <DisplayName>Sensors</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition" IsForward="true">FolderType</Reference>
      <Reference ReferenceType="Organizes" IsForward="false">i=85</Reference>
      <Reference ReferenceType="Organizes" IsForward="true">ns=2;i=2101</Reference>
      <Reference ReferenceType="Organizes" IsForward="true">ns=2;i=2102</Reference>
    </References>
  </UAObject>

  <!-- TempSensor1 instance of SensorType -->
  <UAObject NodeId="ns=2;i=2101" BrowseName="2:TempSensor1" ParentNodeId="ns=2;i=2100">
    <DisplayName>TempSensor1</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition" IsForward="true">ns=2;i=1100</Reference>
      <Reference ReferenceType="Organizes"    IsForward="false">ns=2;i=2100</Reference>
      <Reference ReferenceType="HasComponent" IsForward="true">ns=2;i=2111</Reference>
      <Reference ReferenceType="HasProperty"  IsForward="true">ns=2;i=2112</Reference>
      <Reference ReferenceType="HasComponent" IsForward="true">ns=2;i=2113</Reference>
    </References>
  </UAObject>

  <UAVariable NodeId="ns=2;i=2111" BrowseName="2:Value" DataType="Double" ParentNodeId="ns=2;i=2101" AccessLevel="3">
    <DisplayName>Value</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition" IsForward="true">BaseDataVariableType</Reference>
      <Reference ReferenceType="HasComponent" IsForward="false">ns=2;i=2101</Reference>
    </References>
    <Value><uax:Double>23.5</uax:Double></Value>
  </UAVariable>

  <UAVariable NodeId="ns=2;i=2112" BrowseName="2:Unit" DataType="String" ParentNodeId="ns=2;i=2101">
    <DisplayName>Unit</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition" IsForward="true">PropertyType</Reference>
      <Reference ReferenceType="HasProperty" IsForward="false">ns=2;i=2101</Reference>
    </References>
    <Value><uax:String>degC</uax:String></Value>
  </UAVariable>

  <UAVariable NodeId="ns=2;i=2113" BrowseName="2:InAlarm" DataType="Boolean" ParentNodeId="ns=2;i=2101" AccessLevel="3">
    <DisplayName>InAlarm</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition" IsForward="true">BaseDataVariableType</Reference>
      <Reference ReferenceType="HasComponent" IsForward="false">ns=2;i=2101</Reference>
    </References>
    <Value><uax:Boolean>false</uax:Boolean></Value>
  </UAVariable>

  <!-- PressureSensor1 instance of SensorType -->
  <UAObject NodeId="ns=2;i=2102" BrowseName="2:PressureSensor1" ParentNodeId="ns=2;i=2100">
    <DisplayName>PressureSensor1</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition" IsForward="true">ns=2;i=1100</Reference>
      <Reference ReferenceType="Organizes"    IsForward="false">ns=2;i=2100</Reference>
      <Reference ReferenceType="HasComponent" IsForward="true">ns=2;i=2121</Reference>
      <Reference ReferenceType="HasProperty"  IsForward="true">ns=2;i=2122</Reference>
      <Reference ReferenceType="HasComponent" IsForward="true">ns=2;i=2123</Reference>
    </References>
  </UAObject>

  <UAVariable NodeId="ns=2;i=2121" BrowseName="2:Value" DataType="Double" ParentNodeId="ns=2;i=2102" AccessLevel="3">
    <DisplayName>Value</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition" IsForward="true">BaseDataVariableType</Reference>
      <Reference ReferenceType="HasComponent" IsForward="false">ns=2;i=2102</Reference>
    </References>
    <Value><uax:Double>4.7</uax:Double></Value>
  </UAVariable>

  <UAVariable NodeId="ns=2;i=2122" BrowseName="2:Unit" DataType="String" ParentNodeId="ns=2;i=2102">
    <DisplayName>Unit</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition" IsForward="true">PropertyType</Reference>
      <Reference ReferenceType="HasProperty" IsForward="false">ns=2;i=2102</Reference>
    </References>
    <Value><uax:String>bar</uax:String></Value>
  </UAVariable>

  <UAVariable NodeId="ns=2;i=2123" BrowseName="2:InAlarm" DataType="Boolean" ParentNodeId="ns=2;i=2102" AccessLevel="3">
    <DisplayName>InAlarm</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition" IsForward="true">BaseDataVariableType</Reference>
      <Reference ReferenceType="HasComponent" IsForward="false">ns=2;i=2102</Reference>
    </References>
    <Value><uax:Boolean>true</uax:Boolean></Value>
  </UAVariable>

  <!-- Motors folder (ns=3) -->
  <UAObject NodeId="ns=3;i=2000" BrowseName="3:Motors">
    <DisplayName>Motors</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition" IsForward="true">FolderType</Reference>
      <Reference ReferenceType="Organizes" IsForward="false">i=85</Reference>
      <Reference ReferenceType="Organizes" IsForward="true">ns=3;i=2001</Reference>
      <Reference ReferenceType="Organizes" IsForward="true">ns=3;i=2002</Reference>
    </References>
  </UAObject>

  <!-- Motor1 instance of MotorType -->
  <UAObject NodeId="ns=3;i=2001" BrowseName="3:Motor1" ParentNodeId="ns=3;i=2000">
    <DisplayName>Motor1</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition" IsForward="true">ns=3;i=1000</Reference>
      <Reference ReferenceType="Organizes"    IsForward="false">ns=3;i=2000</Reference>
      <Reference ReferenceType="HasComponent" IsForward="true">ns=3;i=2011</Reference>
      <Reference ReferenceType="HasComponent" IsForward="true">ns=3;i=2012</Reference>
      <Reference ReferenceType="HasProperty"  IsForward="true">ns=3;i=2013</Reference>
    </References>
  </UAObject>

  <UAVariable NodeId="ns=3;i=2011" BrowseName="3:Speed" DataType="Double" ParentNodeId="ns=3;i=2001" AccessLevel="3">
    <DisplayName>Speed</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition" IsForward="true">BaseDataVariableType</Reference>
      <Reference ReferenceType="HasComponent" IsForward="false">ns=3;i=2001</Reference>
    </References>
    <Value><uax:Double>1450</uax:Double></Value>
  </UAVariable>

  <UAVariable NodeId="ns=3;i=2012" BrowseName="3:Running" DataType="Boolean" ParentNodeId="ns=3;i=2001" AccessLevel="3">
    <DisplayName>Running</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition" IsForward="true">BaseDataVariableType</Reference>
      <Reference ReferenceType="HasComponent" IsForward="false">ns=3;i=2001</Reference>
    </References>
    <Value><uax:Boolean>true</uax:Boolean></Value>
  </UAVariable>

  <UAVariable NodeId="ns=3;i=2013" BrowseName="3:SerialNumber" DataType="String" ParentNodeId="ns=3;i=2001">
    <DisplayName>SerialNumber</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition" IsForward="true">PropertyType</Reference>
      <Reference ReferenceType="HasProperty" IsForward="false">ns=3;i=2001</Reference>
    </References>
    <Value><uax:String>MOT-2025-001</uax:String></Value>
  </UAVariable>

  <!-- Motor2 instance of MotorType -->
  <UAObject NodeId="ns=3;i=2002" BrowseName="3:Motor2" ParentNodeId="ns=3;i=2000">
    <DisplayName>Motor2</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition" IsForward="true">ns=3;i=1000</Reference>
      <Reference ReferenceType="Organizes"    IsForward="false">ns=3;i=2000</Reference>
      <Reference ReferenceType="HasComponent" IsForward="true">ns=3;i=2021</Reference>
      <Reference ReferenceType="HasComponent" IsForward="true">ns=3;i=2022</Reference>
      <Reference ReferenceType="HasProperty"  IsForward="true">ns=3;i=2023</Reference>
    </References>
  </UAObject>

  <UAVariable NodeId="ns=3;i=2021" BrowseName="3:Speed" DataType="Double" ParentNodeId="ns=3;i=2002" AccessLevel="3">
    <DisplayName>Speed</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition" IsForward="true">BaseDataVariableType</Reference>
      <Reference ReferenceType="HasComponent" IsForward="false">ns=3;i=2002</Reference>
    </References>
    <Value><uax:Double>0</uax:Double></Value>
  </UAVariable>

  <UAVariable NodeId="ns=3;i=2022" BrowseName="3:Running" DataType="Boolean" ParentNodeId="ns=3;i=2002" AccessLevel="3">
    <DisplayName>Running</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition" IsForward="true">BaseDataVariableType</Reference>
      <Reference ReferenceType="HasComponent" IsForward="false">ns=3;i=2002</Reference>
    </References>
    <Value><uax:Boolean>false</uax:Boolean></Value>
  </UAVariable>

  <UAVariable NodeId="ns=3;i=2023" BrowseName="3:SerialNumber" DataType="String" ParentNodeId="ns=3;i=2002">
    <DisplayName>SerialNumber</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition" IsForward="true">PropertyType</Reference>
      <Reference ReferenceType="HasProperty" IsForward="false">ns=3;i=2002</Reference>
    </References>
    <Value><uax:String>MOT-2025-002</uax:String></Value>
  </UAVariable>

</UANodeSet>
